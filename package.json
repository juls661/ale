{
  "name": "ale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm test && npm run lint && npm run build && npm run test:e2e",
    "windows:build": "node scripts/build-windows.mjs",
    "macos:build": "node scripts/build-macos.mjs",
    "macos:prepare": "npm run build && node scripts/prepare-macos.mjs",
    "macos:test": "node scripts/test-macos.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/dev/inspect-ui.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  },
  "description": "Ale, an independent music player for Windows and macOS"
}
